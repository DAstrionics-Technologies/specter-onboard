# /etc/systemd/system/camera-relay.service
[Unit]
Description=Camera RTSP Relay
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=gst-launch-1.0 rtspsrc location=rtsp://192.168.144.25:8554/main.264 latency=0 ! \
  rtph265depay ! rtph265pay config-interval=1 pt=96 mtu=1200 ! \
  udpsink host=192.168.10.120 port=5600
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user-default.target
